{
    "extends": [
        "@vinicius1313/tsconfig/tsconfig.json",
        "@react-native/typescript-config"
    ],
    "compilerOptions": {
        "downlevelIteration": null,
        "paths": {
            "path": [
                "./src/polyfills/path.ts"
            ],
            "node:path": [
                "./src/polyfills/path.ts"
            ],
            "@components": [
                "./src/components/index.ts"
            ],
            "@database": [
                "./src/database/index.ts"
            ],
            "@hooks": [
                "./src/hooks/index.ts"
            ],
            "@locale": [
                "./src/locale/index.ts"
            ],
            "@modules/*": [
                "./src/modules/*"
            ],
            "@routes": [
                "./src/routes/index.ts"
            ],
            "@screens/*": [
                "./src/screens/*"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@theme": [
                "./src/theme/index.ts"
            ],
            "@types": [
                "./src/types/index.ts"
            ],
            "@utils": [
                "./src/utils/index.ts"
            ]
        },
        "types": [
            "jest"
        ]
    },
    "include": [
        "src/**/*",
        "index.js"
    ],
    "exclude": [
        "**/node_modules",
        "**/Pods"
    ]
}
